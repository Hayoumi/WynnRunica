        {
          "id": "item-description-4a89399abb6d8524",
          "en": "<em>different ways. Some reasons are",
          "ru": "<em>§7это прежде. Одни доводы"
        },
        {
          "id": "item-description-5909e766af2350d0",
          "en": "<em>fine, some are weak. But what sort",
          "ru": "<em>§7весомы, другие слабы. Но"
        },
        {
          "id": "item-description-cab39ae8482ea5da",
          "en": "<em>of justification is there, for",
          "ru": "<em>§7чем оправдываются те,"
        },
        {
          "id": "item-description-473e613561919667",
          "en": "<em>those in the highest position? You",
          "ru": "<em>§7кто стоит выше всех?"
        },
        {
          "id": "item-description-94673419d2a560a6",
          "en": "<em>have the floor.",
          "ru": "<em>§7Теперь слово за вами."
        }
      ]
